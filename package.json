{
  "name": "itemize-monorepo",
  "version": "1.0.0",
  "description": "Itemize full-stack application",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:graphql\" \"npm run dev:frontend\" \"npm run docs:watch\"",
    "dev:graphql": "npm run start:dev --workspace itemize-graphql-api",
    "dev:frontend": "cd frontend && npm run dev",
    "start:frontend": "cd frontend && npm run preview",
    "build": "npm run docs:sync && npm run docs:check && npm run build:graphql && npm run build:frontend && npm run build:check --workspace itemize-frontend",
    "build:graphql": "npm run build --workspace itemize-graphql-api",
    "build:frontend": "cd frontend && npm run build",
    "lint:frontend": "cd frontend && node ../node_modules/eslint/bin/eslint.js .",
    "docs:sync": "node sync-docs.js sync",
    "docs:watch": "node sync-docs.js watch",
    "docs:check": "node sync-docs.js check",
    "release:contracts": "npm run docs:check && npm run config:check --workspace itemize-graphql-api && npm run test:contract --workspace itemize-graphql-api",
    "release:integration": "npm run test:integration:fresh --workspace itemize-db",
    "release:check": "npm run release:contracts && npm run build:graphql && npm run build:frontend && npm run build:check --workspace itemize-frontend",
    "test:graphql": "npm run test --workspace itemize-graphql-api",
    "test:frontend": "npm run test --workspace itemize-frontend -- --run",
    "test:integration:fresh": "npm run test:integration:fresh --workspace itemize-db",
    "test": "npm run test:frontend && npm run test:graphql",
    "migrate": "npm run migrate --workspace itemize-db"
  },
  "devDependencies": {
    "brace-expansion": "1.1.18",
    "chokidar": "^3.5.3",
    "concurrently": "^8.2.2"
  },
  "workspaces": [
    "frontend",
    "backend-v2",
    "db"
  ],
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@opentelemetry/api": "^1.9.1",
    "dompurify": "3.4.14",
    "express-rate-limit": "^7.5.1"
  },
  "overrides": {
    "@apollo/server-plugin-landing-page-graphql-playground": {
      "@apollo/server": "$@apollo/server"
    },
    "@nestjs/graphql": {
      "ws@8.20.1": "8.21.1"
    }
  }
}
