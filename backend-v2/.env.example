# Core runtime
NODE_ENV=development
PORT=3100
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/itemize
DATABASE_SSL=false
DATABASE_POOL_MAX=10
JWT_SECRET=replace-with-the-same-secret-used-by-the-legacy-backend
SESSION_SECRET=replace-with-the-same-session-secret-used-by-the-legacy-backend
FRONTEND_URL=http://localhost:5173
TZ=America/New_York
# HEALTHCHECK_STARTUP_GRACE_MS=60000
# SENTRY_DSN=

# Public and internal origins
# APP_URL=https://itemize.cloud
# API_URL=https://api.itemize.cloud
# BACKEND_URL=https://api.itemize.cloud
# PUBLIC_API_URL=https://api.itemize.cloud
# PROD_URL=https://itemize.cloud
# RAILWAY_PUBLIC_DOMAIN=
# CORS_ORIGIN=http://localhost:5173
# EXTRA_CORS_ORIGINS=https://staging.itemize.cloud
# COOKIE_DOMAIN=.itemize.cloud
# EMAIL_ASSET_ORIGIN=https://itemize.cloud

# Authentication, OAuth, and encryption
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALENDAR_REDIRECT_URI=
# CALENDAR_OAUTH_STATE_SECRET=
# CALENDAR_TOKEN_ENCRYPTION_KEYS=
# CALENDAR_TOKEN_ACTIVE_KEY_ID=
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# FACEBOOK_REDIRECT_URI=
# FACEBOOK_WEBHOOK_VERIFY_TOKEN=
# STRIPE_CONNECT_REDIRECT_URI=
# STRIPE_CONNECT_STATE_SECRET=
# ESTIMATE_TOKEN_DERIVATION_KEY=
# SIGNATURE_TOKEN_DERIVATION_KEY=
# VAULT_ENCRYPTION_KEY=

# Email, SMS, storage, malware scanning, and AI providers
# RESEND_API_KEY=
# RESEND_WEBHOOK_SECRET=
# EMAIL_FROM=Itemize <noreply@itemize.cloud>
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_REGION=us-west-2
# AWS_S3_BUCKET=
# SIGNATURE_CLAMAV_HOST=
# SIGNATURE_CLAMAV_PORT=3310
# SIGNATURE_CLAMAV_TIMEOUT_MS=10000
# SIGNATURE_MALWARE_SCAN_REQUIRED=false
# GEMINI_API_KEY=
# MARKETING_CHAT_AI_ENABLED=true
# MARKETING_CHAT_AI_MODEL=gemini-2.5-flash

# Stripe billing and Connect
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_BILLING_WEBHOOK_SECRET=
# STRIPE_INVOICE_WEBHOOK_SECRET=
# STRIPE_CLIENT_ID=
# STRIPE_PRICE_STARTER_MONTHLY=
# STRIPE_PRICE_STARTER_YEARLY=
# STRIPE_PRICE_UNLIMITED_MONTHLY=
# STRIPE_PRICE_UNLIMITED_YEARLY=
# STRIPE_PRICE_PRO_MONTHLY=
# STRIPE_PRICE_PRO_YEARLY=
# ITEMIZE_SUBSCRIPTION_BILLING_ENABLED=false

# Continuous worker ownership. All NestJS switches are intentionally default-off.
# Transfer ownership by disabling the legacy switch before enabling its NestJS peer.
# LEGACY_INVOICE_JOBS_ENABLED=true
# INVOICE_NEST_JOBS_ENABLED=false
# TRIAL_REMINDER_CRON_ENABLED=true
# TRIAL_REMINDER_NEST_JOBS_ENABLED=false
# LEGACY_SIGNATURE_REMINDER_JOBS_ENABLED=true
# SIGNATURE_JOBS_SCHEDULER_ENABLED=false
# SIGNATURE_FILE_CLEANUP_ENABLED=false
# SIGNATURE_FILE_CLEANUP_NEST_ENABLED=false
# ESTIMATE_EMAIL_DELIVERY_SCHEDULER_ENABLED=false
# REPUTATION_REQUEST_DELIVERY_SCHEDULER_ENABLED=false
# MESSAGE_DELIVERY_SCHEDULER_ENABLED=false
# ADMIN_EMAIL_DELIVERY_SCHEDULER_ENABLED=false
# SOCIAL_MESSAGE_DELIVERY_SCHEDULER_ENABLED=false
# CALENDAR_SYNC_JOBS_ENABLED=false
# CALENDAR_SYNC_NEST_JOBS_ENABLED=false
# EMAIL_WEBHOOK_JOBS_ENABLED=true
# EMAIL_WEBHOOK_NEST_JOBS_ENABLED=false
# SUBSCRIPTION_WEBHOOK_JOBS_ENABLED=true
# SUBSCRIPTION_WEBHOOK_NEST_JOBS_ENABLED=false
# SOCIAL_WEBHOOK_JOBS_ENABLED=true
# SOCIAL_WEBHOOK_NEST_JOBS_ENABLED=false
# REALTIME_HOST_NESTJS_ENABLED=false
# WORKFLOW_NEST_SCHEDULER_ENABLED=false

# Worker cadence and queue tuning
# ADMIN_EMAIL_DELIVERY_BATCH_SIZE=25
# ADMIN_EMAIL_DELIVERY_INTERVAL_MS=15000
# CALENDAR_SYNC_JOB_BATCH_SIZE=10
# CALENDAR_SYNC_JOB_LEASE_SECONDS=300
# CALENDAR_SYNC_JOB_MAX_ATTEMPTS=5
# CALENDAR_SYNC_NEST_JOBS_INTERVAL_MS=60000
# EMAIL_WEBHOOK_JOB_BATCH_SIZE=25
# EMAIL_WEBHOOK_JOB_LEASE_SECONDS=300
# EMAIL_WEBHOOK_JOB_MAX_ATTEMPTS=5
# EMAIL_WEBHOOK_NEST_JOBS_INTERVAL_MS=60000
# ESTIMATE_EMAIL_DELIVERY_BATCH_SIZE=25
# ESTIMATE_EMAIL_DELIVERY_SCHEDULER_INTERVAL_MS=15000
# MESSAGE_DELIVERY_BATCH_SIZE=25
# MESSAGE_DELIVERY_INTERVAL_MS=15000
# RECURRING_INVOICE_BATCH_SIZE=100
# REPUTATION_REQUEST_DELIVERY_BATCH_SIZE=25
# REPUTATION_REQUEST_DELIVERY_INTERVAL_MS=60000
# SIGNATURE_COMPLETION_BATCH_SIZE=25
# SIGNATURE_COMPLETION_LEASE_SECONDS=300
# SIGNATURE_COMPLETION_MAX_ATTEMPTS=5
# SIGNATURE_COMPLETION_RETRY_BASE_MS=60000
# SIGNATURE_COMPLETION_RETRY_MAX_MS=3600000
# SIGNATURE_DELIVERY_BATCH_SIZE=25
# SIGNATURE_DELIVERY_LEASE_SECONDS=300
# SIGNATURE_DELIVERY_MAX_ATTEMPTS=5
# SIGNATURE_DELIVERY_RETRY_BASE_MS=60000
# SIGNATURE_DELIVERY_RETRY_MAX_MS=3600000
# SIGNATURE_FILE_CLEANUP_BATCH_SIZE=25
# SIGNATURE_FILE_CLEANUP_LEASE_SECONDS=300
# SIGNATURE_FILE_CLEANUP_MAX_ATTEMPTS=5
# SIGNATURE_FILE_CLEANUP_NEST_INTERVAL_MS=900000
# SIGNATURE_JOBS_SCHEDULER_INTERVAL_MS=15000
# SIGNATURE_REMINDER_BATCH_SIZE=25
# SOCIAL_MESSAGE_DELIVERY_BATCH_SIZE=25
# SOCIAL_MESSAGE_DELIVERY_INTERVAL_MS=15000
# SOCIAL_WEBHOOK_NEST_JOBS_INTERVAL_MS=60000
# SUBSCRIPTION_WEBHOOK_NEST_JOBS_INTERVAL_MS=60000
# TRIAL_REMINDER_BATCH_SIZE=100
# TRIAL_REMINDER_LEASE_SECONDS=300
# TRIAL_REMINDER_MAX_ATTEMPTS=5
# WORKFLOW_NEST_SCHEDULER_INTERVAL_MS=60000
# WORKFLOW_SCHEDULE_BATCH_SIZE=100
# WORKFLOW_TRIGGER_BATCH_SIZE=25
# WORKFLOW_TRIGGER_LEASE_SECONDS=300
# WORKFLOW_TRIGGER_MAX_ATTEMPTS=5
# WORKFLOW_TRIGGER_RETRY_BASE_MS=60000
# WORKFLOW_TRIGGER_RETRY_MAX_MS=3600000
# WORKFLOW_ENROLLMENT_BATCH_SIZE=25
# WORKFLOW_ENROLLMENT_LEASE_SECONDS=300
# WORKFLOW_SIDE_EFFECT_BATCH_SIZE=25
# WORKFLOW_SIDE_EFFECT_LEASE_SECONDS=300
# WORKFLOW_SIDE_EFFECT_MAX_ATTEMPTS=5
# WORKFLOW_SIDE_EFFECT_RETRY_BASE_MS=60000
# WORKFLOW_SIDE_EFFECT_RETRY_MAX_MS=3600000

# One-shot worker selectors
# SIGNATURE_COMPLETION_JOB_ID=
# SIGNATURE_DELIVERY_ID=
# WORKFLOW_ID=
# WORKFLOW_TRIGGER_ID=
# WORKFLOW_ENROLLMENT_ID=
# WORKFLOW_SIDE_EFFECT_ID=

# Webhook and controlled-egress safety
# SKIP_TWILIO_WEBHOOK_VALIDATION=false
# ALLOW_INSECURE_WORKFLOW_WEBHOOKS=false
# WORKFLOW_WEBHOOK_TIMEOUT_MS=10000
# WORKFLOW_WEBHOOK_MAX_REQUEST_BYTES=65536
# WORKFLOW_WEBHOOK_MAX_RESPONSE_BYTES=262144
